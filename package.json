{
    "name": "acestes-agent",
    "version": "1.3.5",
    "description": "Acestes Agent - an agentic desktop workspace with persistent memory, local file access and SSH sessions. Forked from CloudTerm.",
    "main": "src/main/main.js",
    "scripts": {
        "postinstall": "patch-package",
        "start": "electron .",
        "test": "node test/snippets.test.js && node test/host-tags.test.js && node test/backup.test.js && node test/activity.test.js && node test/telnet.test.js && node test/serial.test.js && node test/session-log.test.js && node test/server-sync.test.js && node test/os-detect.test.js && node test/cloud-snapshot.test.js && node test/jump-host.test.js && node test/transcript.test.js && node test/turn-rate.test.js && node test/assistant-approval.test.js && node test/assistant-terminal.test.js && node test/assistant-images.test.js && node test/assistant-mentions.test.js && node test/skills.test.js && node test/sandbox.test.js && node test/local-terminal.test.js && node test/conversation-search.test.js && node test/conversation-history.test.js &&node test/inventory-tools.test.js && node test/files.test.js &&node test/runs.test.js && node test/jobs.test.js && node test/harness.test.js && node test/mcp-probe.test.js && node test/mcp-host.test.js && node test/secrets.test.js && node test/diff.test.js && node test/checkpoints.test.js && node test/turn-changes.test.js && node test/conversation-tools.test.js && node test/computer.test.js && node test/activity-overlay.test.js && node test/speech.test.js && node test/browser-use.test.js && node test/transcript-reducer.test.js && node test/group-rows.test.js && node test/done-sound.test.js && node test/chart.test.js && node test/memory-switch.test.js &&node test/titles.test.js && node test/conversation-titles.test.js && node test/panes.test.js && node test/agents-secrets.test.js && node test/agents-look.test.js && node test/opencode-provider.test.js && node test/codex-provider.test.js && node test/claude-provider.test.js && node test/subagents.test.js &&node test/grok-provider.test.js && node test/kimi-provider.test.js && node test/local-provider.test.js && node test/accounts-limits.test.js && node test/model-accounts.test.js && node test/hidden-models.test.js && node test/default-model.test.js && node test/context-usage.test.js && node test/acp-provider.test.js && node test/mcp-bridge.test.js && node test/muse-provider.test.js && node test/antigravity-provider.test.js && node test/pi-provider.test.js && node test/shell-path.test.js && node test/updates.test.js",
        "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
        "dev:vite": "vite",
        "dev:electron": "wait-on tcp:5173 && electron .",
        "build:css": "npx tailwindcss -i ./src/renderer/input.css -o ./src/renderer/styles.css",
        "build:hello": "node scripts/build-hello-helper.js",
        "build:desktop": "node scripts/build-desktop-helper.js",
        "build:mac-icon": "node scripts/build-mac-icon.js",
        "build:renderer": "vite build",
        "build:electron": "electron-builder --win --x64",
        "build:electron:mac": "electron-builder --mac",
        "build:electron:linux": "electron-builder --linux AppImage",
        "build": "npm run build:hello && npm run build:desktop && npm run build:css && npm run build:renderer && npm run build:electron",
        "build:mac": "npm run build:desktop && npm run build:renderer && npm run build:electron:mac",
        "build:linux": "npm run build:renderer && npm run build:electron:linux"
    },
    "build": {
        "appId": "com.acestes.agent",
        "productName": "Acestes Agent",
        "directories": {
            "output": "dist"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "BradPerbs",
                "repo": "acestes-agent"
            }
        ],
        "files": [
            "src/main/**/*",
            "dist/renderer/**/*",
            "THIRD-PARTY-NOTICES.md",
            "resources/**/*",
            "!resources/README.md",
            "!resources/hello-helper.exe",
            "!resources/desktop-helper.exe",
            "!resources/desktop-helper.old-*.exe",
            "!resources/desktop-helper",
            "!resources/desktop-helper.new",
            "!**/node_modules/@openai/codex-*/vendor/**",
            "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
            "!**/node_modules/@hugeicons/**",
            "!**/node_modules/hugeicons-react/**",
            "!**/node_modules/@fontsource/**",
            "!**/node_modules/@xterm/**",
            "!**/node_modules/gsap/**",
            "!**/node_modules/react/**",
            "!**/node_modules/react-dom/**",
            "!**/node_modules/react-hot-toast/**"
        ],
        "asarUnpack": [
            "src/main/ai/pi-extension.mjs",
            "**/node_modules/@serialport/bindings-cpp/**",
            "**/node_modules/@lydell/node-pty*/**",
            "**/node_modules/@anthropic-ai/claude-agent-sdk/**",
            "**/node_modules/onnxruntime-node/**",
            "**/node_modules/@huggingface/transformers/**",
            "**/node_modules/sherpa-onnx-*/**",
            "**/node_modules/sharp/**",
            "**/node_modules/@img/**"
        ],
        "extraResources": [
            {
                "from": "resources/",
                "to": "resources/",
                "filter": [
                    "**/*",
                    "!README.md",
                    "!hello-helper.exe",
                    "!desktop-helper.exe",
                    "!desktop-helper.old-*.exe",
                    "!desktop-helper",
                    "!desktop-helper.new"
                ]
            },
            {
                "from": "build/icon.png",
                "to": "icon.png"
            },
            {
                "from": "build/icon.ico",
                "to": "icon.ico"
            }
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "build/icon.png",
            "files": [
                "src/main/**/*",
                "dist/renderer/**/*",
                "resources/**/*",
                "!resources/README.md",
                "!resources/desktop-helper.old-*.exe",
                "!**/node_modules/@openai/codex-*/vendor/**",
                "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
                "!**/node_modules/@hugeicons/**",
                "!**/node_modules/hugeicons-react/**",
                "!**/node_modules/@fontsource/**",
                "!**/node_modules/@xterm/**",
                "!**/node_modules/gsap/**",
                "!**/node_modules/react/**",
                "!**/node_modules/react-dom/**",
                "!**/node_modules/react-hot-toast/**",
                "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
                "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/**"
            ],
            "extraResources": [
                {
                    "from": "resources/hello-helper.exe",
                    "to": "resources/hello-helper.exe"
                },
                {
                    "from": "resources/desktop-helper.exe",
                    "to": "resources/desktop-helper.exe"
                }
            ]
        },
        "portable": {
            "artifactName": "AcestesAgent-${arch}.exe"
        },
        "nsis": {
            "artifactName": "AcestesAgent-Setup-${arch}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Acestes Agent",
            "deleteAppDataOnUninstall": false,
            "perMachine": false
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "category": "public.app-category.developer-tools",
            "darkModeSupport": true,
            "icon": "build/icon.icon",
            "artifactName": "AcestesAgent-${arch}.${ext}",
            "extraResources": [
                {
                    "from": "resources/desktop-helper",
                    "to": "resources/desktop-helper"
                }
            ]
        },
        "dmg": {
            "background": null,
            "icon": null,
            "window": {
                "width": 500,
                "height": 340
            },
            "contents": [
                {
                    "x": 130,
                    "y": 170,
                    "type": "file"
                },
                {
                    "x": 370,
                    "y": 170,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "linux": {
            "target": "AppImage",
            "category": "Development",
            "synopsis": "Agentic desktop workspace",
            "artifactName": "AcestesAgent-${arch}.${ext}",
            "icon": "build/icon.png",
            "desktop": {
                "entry": {
                    "Categories": "Development;Network;",
                    "Keywords": "ssh;sftp;terminal;rdp;vnc;serial;"
                }
            }
        }
    },
    "keywords": [
        "ssh",
        "terminal",
        "electron",
        "agent"
    ],
    "author": "Acestes",
    "license": "SEE LICENSE IN LICENSE",
    "devDependencies": {
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.23",
        "concurrently": "^9.2.1",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "patch-package": "^8.0.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "vite": "^5.0.12",
        "wait-on": "^7.2.0"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.220",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@huggingface/transformers": "^4.2.0",
        "@lydell/node-pty": "1.2.0-beta.15",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@openai/codex-sdk": "^0.146.0",
        "@opencode-ai/sdk": "^1.18.10",
        "@xterm/addon-fit": "^0.9.0",
        "@xterm/addon-search": "^0.15.0",
        "@xterm/addon-web-links": "^0.11.0",
        "@xterm/addon-webgl": "^0.18.0",
        "@xterm/xterm": "^5.4.0",
        "croner": "^10.0.1",
        "cross-spawn": "^7.0.6",
        "electron-updater": "^6.8.9",
        "gsap": "^3.15.0",
        "hugeicons-react": "^0.4.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hot-toast": "^2.6.0",
        "serialport": "^12.0.0",
        "sherpa-onnx-node": "^1.13.8",
        "ssh2": "^1.15.0",
        "zod": "^4.0.0"
    }
}
